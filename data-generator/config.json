{
  "simulation": {
    "start_date": "2026-08-03",
    "hours": 24,
    "interval_minutes": 1,
    "timezone": "Africa/Cairo",
    "utc_offset": "+03:00",
    "random_seed": 42
  },
  "patterns": {
    "business_window": { "start": "06:00", "end": "22:00" },
    "night_standby_window": { "start": "22:00", "end": "06:00" },
    "peak_window": { "start": "18:00", "end": "22:00" },
    "daytime_baseline_factor": 1.0,
    "night_standby_factor_range": [0.15, 0.25],
    "peak_surge_factor_range": [1.5, 2.2],
    "morning_ramp_start": "05:00",
    "morning_ramp_end": "07:00",
    "evening_ramp_start": "17:00",
    "evening_ramp_end": "18:00",
    "voltage_nominal_v": 380.0,
    "voltage_fluctuation_pct": 5.0,
    "voltage_sag_during_peak_pct": 3.0,
    "frequency_nominal_hz": 50.0,
    "frequency_jitter_pct": 0.1,
    "power_factor_range": [0.85, 0.98]
  },
  "anomalies": {
    "spike_threshold_percent": 30.0,
    "forced_spike": {
      "count_per_facility": 3,
      "boost_factor_range": [1.3, 2.5],
      "duration_minutes_range": [2, 6]
    },
    "micro_surge": {
      "count_per_facility": 2,
      "window_minutes_range": [15, 30],
      "boost_factor_range": [1.05, 1.15],
      "severity": "predictive_maintenance"
    }
  },
  "carbon_factor_kg_per_kwh": 0.85,
  "output": {
    "dir": "output",
    "json_file": "telemetry_data.json",
    "csv_file": "telemetry_data.csv"
